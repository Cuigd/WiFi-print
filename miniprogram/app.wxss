page {
  min-height: 100vh;
  color: #202124;
  background: #f5f6f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.safe-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 140rpx;
}

.muted {
  color: #8a8f98;
}

.primary-text {
  color: #208b73;
}

.soft-card {
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 22rpx rgba(38, 48, 58, 0.06);
}

.btn {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  line-height: 88rpx;
}

.btn-primary {
  color: #fff;
  background: #19b69a;
}

.btn-primary[disabled] {
  color: rgba(255, 255, 255, 0.82);
  background: #9ed9cd;
}

.home-page {
  padding-top: 18rpx;
}

.brand-bar {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.brand-mark {
  font-size: 22rpx;
  font-weight: 700;
  color: #1d1f23;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #218a74;
}

.device-card {
  min-height: 156rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 28rpx 26rpx;
}

.device-logo {
  width: 140rpx;
  flex: none;
  font-size: 32rpx;
  font-weight: 800;
  color: #070707;
}

.device-state {
  flex: 1;
}

.state-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 48rpx;
  font-size: 32rpx;
  color: #111;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 12rpx;
  color: #c01743;
  background: #ffd4df;
  font-size: 24rpx;
}

.status-pill.online {
  color: #158b72;
  background: #d9f5eb;
}

.printer-name {
  max-width: 350rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  width: 42rpx;
  text-align: right;
  color: #8a8f98;
  font-size: 52rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 24rpx;
}

.feature-card {
  min-height: 204rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 30rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(135deg, #02b9b3 0%, #11c9a7 48%, #dcefe7 100%);
}

.feature-icon {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.green-icon {
  border-radius: 18rpx;
  color: #fff;
  background: #60d566;
}

.blue-icon {
  color: #157fdc;
  font-size: 68rpx;
}

.navy-icon {
  color: #3b4665;
  font-size: 62rpx;
}

.outline-icon {
  border: 2rpx dashed rgba(255, 255, 255, 0.76);
  color: rgba(255, 255, 255, 0.95);
  font-size: 26rpx;
}

.feature-title {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.feature-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.more-panel {
  margin-top: 28rpx;
  padding: 34rpx 24rpx 56rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 36rpx;
}

.more-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 42rpx;
}

.more-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #252a30;
}

.more-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  box-shadow: 0 8rpx 18rpx rgba(32, 42, 52, 0.07);
}

.folder-icon {
  position: relative;
  background: #f7f8fa;
}

.folder-icon::before,
.folder-icon::after {
  position: absolute;
  content: "";
  left: 18rpx;
  background: #ffbd17;
}

.folder-icon::before {
  top: 28rpx;
  width: 34rpx;
  height: 18rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.folder-icon::after {
  top: 40rpx;
  width: 62rpx;
  height: 38rpx;
  border-radius: 4rpx;
}

.app-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.ding {
  color: #fff;
  background: #34a8e6;
}

.qq {
  color: #fff;
  background: #111;
}

.mail {
  color: #fff;
  background: #55bf4a;
}

.wps {
  color: #51516f;
  background: #eef6ef;
  border: 2rpx solid #52506e;
}

.qa {
  color: #fff;
  background: #2f9fea;
  font-size: 48rpx;
}

.bottom-tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #edf0f2;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #1b1f24;
  font-size: 24rpx;
}

.tab-icon {
  font-size: 42rpx;
  line-height: 42rpx;
}

.tab-item.active {
  color: #218a74;
}

<view class="safe-page home-page">
  <view class="brand-bar">
    <text class="brand-mark">济豪®</text>
    <text class="brand-title">济豪云盒</text>
  </view>

  <view class="soft-card device-card" bindtap="discoverPrinters">
    <view class="device-logo">济豪®</view>
    <view class="device-state">
      <view class="state-line">
        <text>{{boundPrinter ? '云盒已绑定' : '云盒未绑定'}}</text>
        <text class="status-pill {{boundPrinter ? 'online' : ''}}">{{boundPrinter ? '可用' : '待绑定'}}</text>
      </view>
      <view class="state-line">
        <text class="printer-name">{{boundPrinter ? boundPrinter.name : '点击搜索局域网打印机'}}</text>
        <text class="status-pill {{boundPrinter ? 'online' : ''}}">{{discovering ? '搜索中' : (boundPrinter ? '已绑定' : '搜索')}}</text>
      </view>
    </view>
    <text class="chevron">›</text>
  </view>

  <view class="feature-grid">
    <view class="feature-card main-card" bindtap="goUpload" data-type="document">
      <view class="feature-icon green-icon">☘</view>
      <text class="feature-title">微信文档</text>
      <text class="feature-subtitle">文件A3/A4打印</text>
    </view>
    <view class="feature-card" bindtap="goUpload" data-type="image">
      <view class="feature-icon blue-icon">□</view>
      <text class="feature-title">图片打印</text>
      <text class="feature-subtitle">照片打印在A4</text>
    </view>
    <view class="feature-card" bindtap="goUpload" data-type="photo">
      <view class="feature-icon navy-icon">▣</view>
      <text class="feature-title">照片打印</text>
      <text class="feature-subtitle">6寸照片打印</text>
    </view>
    <view class="feature-card muted-card" bindtap="showComingSoon">
      <view class="feature-icon outline-icon">等</view>
      <text class="feature-title">发票打印</text>
      <text class="feature-subtitle">二等分三等分打印</text>
    </view>
  </view>

  <view class="soft-card more-panel">
    <view class="section-title">更多</view>
    <view class="more-grid">
      <view class="more-item" bindtap="goUpload" data-type="document">
        <view class="more-icon folder-icon"></view>
        <text>本地文档</text>
      </view>
      <view class="more-item" bindtap="showComingSoon">
        <view class="more-icon app-icon ding">钉</view>
        <text>钉钉</text>
      </view>
      <view class="more-item" bindtap="showComingSoon">
        <view class="more-icon app-icon qq">Q</view>
        <text>QQ</text>
      </view>
      <view class="more-item" bindtap="showComingSoon">
        <view class="more-icon app-icon mail">邮</view>
        <text>QQ邮箱</text>
      </view>
      <view class="more-item" bindtap="showComingSoon">
        <view class="more-icon app-icon wps">WPS</view>
        <text>wps</text>
      </view>
      <view class="more-item" bindtap="showComingSoon">
        <view class="more-icon app-icon qa">?</view>
        <text>Q&amp;A</text>
      </view>
    </view>
  </view>

  <view class="bottom-tabs">
    <view class="tab-item active">
      <text class="tab-icon">⌂</text>
      <text>首页</text>
    </view>
    <view class="tab-item" bindtap="goMaterial">
      <text class="tab-icon">▤</text>
      <text>打印素材</text>
    </view>
    <view class="tab-item" bindtap="goProfile">
      <text class="tab-icon">○</text>
      <text>我的</text>
    </view>
  </view>
</view>

HOST=0.0.0.0
PORT=8080

# Set this in production. The client must send the same value as upload_token.
PRINT_UPLOAD_TOKEN=replace-with-long-random-token

MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=replace-with-mqtt-user
MQTT_PASSWORD=replace-with-mqtt-password
MQTT_TOPIC_PREFIX=cloud-print

DEVICE_ONLINE_WINDOW_SECONDS=30
